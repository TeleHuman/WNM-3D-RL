#!/usr/bin/env bash
# Copy this file to paths.env and edit it. paths.env is ignored by Git.

# Repository and Python/Ray executables.
export WAM_REPO_ROOT=/path/to/WNM-3D-RL
export PYTHON_BIN=python
export RAY_BIN=ray

# WNM-3D code and frozen assets.
export WNM3D_SOURCE_ROOT=/path/to/wnm-3d
export WNM3D_INITIAL_CHECKPOINT=/path/to/policy-initialization-checkpoint
export WAM_DATA_CONTRACT_CHECKPOINT=/path/to/data-contract-checkpoint
export WNM_TOKENIZER_SOURCE=/path/to/umt5-xxl
export WNM_TEXT_ENCODER_SOURCE=/path/to/models_t5_umt5-xxl-enc-bf16.pth
export WNM_IMAGE_ENCODER_SOURCE=/path/to/models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth
export WNM_VAE_SOURCE=/path/to/Wan2.2_VAE.pth
export WNM_VGGT_SOURCE=/path/to/vggt_omega_1b_512.pt

# Converted training data and held-out event validation.
export WAM_DATA_ROOT=/path/to/stage3-training-data
export WAM_EVENT_VAL_FILE=/path/to/stage3-event-validation.parquet
# Set these to the exact counts recorded by the selected dataset manifests.
export WAM_EXPECTED_TRAIN_SIZE=
export WAM_VAL_MAX_SAMPLES=

# Durable outputs. Runtime staging may still use node-local tmpfs.
export WAM_OUTPUT_DIR=/path/to/outputs/stage3_navigation_grpo

# Runtime topology. Defaults form a single-node launch. For N nodes, use the
# same paths.env everywhere and override NNODES=N, NODE_RANK=0..N-1, and
# MASTER_ADDR=<head-ip> in each launch command.
export NNODES=${NNODES:-1}
export NODE_RANK=${NODE_RANK:-0}
# Leave MASTER_ADDR unset for one node; resources.env.sh uses loopback.
# For NNODES > 1, provide the head node's routable IPv4 address at launch.
export GPUS_PER_NODE=${GPUS_PER_NODE:-8}
export CPUS_PER_NODE=${CPUS_PER_NODE:-32}
# Ray/Gloo need an IPv4-capable control interface. NCCL payloads use the
# eight IB/RoCE HCAs below by default; NCCL_SOCKET_IFNAME is only bootstrap and
# socket fallback, not a request to disable the IB transport.
export RAY_NODE_IFNAME=${RAY_NODE_IFNAME:-bond0}
export NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-bond0}
export GLOO_SOCKET_IFNAME=${GLOO_SOCKET_IFNAME:-bond0}
export NCCL_IB_DISABLE=${NCCL_IB_DISABLE:-0}
export NCCL_IB_HCA=${NCCL_IB_HCA:-'=mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_6,mlx5_7'}
# Set false on clusters that do not expose exactly mlx5_0 through mlx5_7.
export WAM_VERIFY_EIGHT_HCA_TOPOLOGY=${WAM_VERIFY_EIGHT_HCA_TOPOLOGY:-true}
# Launch fails closed when a node already has a Ray runtime. Set this only when
# replacing that node-local runtime is intentional.
export WAM_REPLACE_EXISTING_RAY=${WAM_REPLACE_EXISTING_RAY:-false}
